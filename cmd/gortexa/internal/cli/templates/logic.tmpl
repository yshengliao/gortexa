package logic

import (
	"cmp"
	"context"
	"crypto/rand"
	"encoding/hex"
	"slices"
	"sync"

	"google.golang.org/protobuf/proto"
	"google.golang.org/protobuf/types/known/emptypb"
	"google.golang.org/protobuf/types/known/timestamppb"

	[[.GoPkg]] "[[.Module]]/gen/[[.Domain]]/[[.Version]]"
	apperr "[[.Module]]/internal/errors"
)

// [[.Entity]]Service is an in-memory implementation of
// [[.Domain]].[[.Version]].[[.Entity]]Service. Back it with internal/storage for
// a real datastore; the in-memory store is enough to exercise gRPC, the gateway
// and MCP end-to-end.
type [[.Entity]]Service struct {
	[[.GoPkg]].Unimplemented[[.Entity]]ServiceServer
	mu    sync.RWMutex
	store map[string]*[[.GoPkg]].[[.Entity]]
}

// New[[.Entity]]Service returns an empty in-memory service.
func New[[.Entity]]Service() *[[.Entity]]Service {
	return &[[.Entity]]Service{store: make(map[string]*[[.GoPkg]].[[.Entity]])}
}

func new[[.Entity]]ID() string {
	var b [16]byte
	_, _ = rand.Read(b[:])
	return hex.EncodeToString(b[:])
}

// clone[[.Entity]] isolates stored state from callers (the mutation boundary).
func clone[[.Entity]](r *[[.GoPkg]].[[.Entity]]) *[[.GoPkg]].[[.Entity]] {
	return proto.Clone(r).(*[[.GoPkg]].[[.Entity]])
}

// Create[[.Entity]] stores a new [[.Snake]], assigning an id and timestamp.
func (s *[[.Entity]]Service) Create[[.Entity]](_ context.Context, req *[[.GoPkg]].Create[[.Entity]]Request) (*[[.GoPkg]].[[.Entity]], error) {
	in := req.Get[[.Entity]]()
	if in == nil {
		return nil, apperr.New(apperr.CatInvalidArgument, "[[.Snake]] is required")
	}
	out := &[[.GoPkg]].[[.Entity]]{
		Id:        new[[.Entity]]ID(),
		Name:      in.GetName(),
		CreatedAt: timestamppb.Now(),
	}
	s.mu.Lock()
	defer s.mu.Unlock()
	s.store[out.Id] = out
	// Clone under the lock: a concurrent Update mutates the stored message in
	// place, so cloning after releasing the lock would be a data race.
	return clone[[.Entity]](out), nil
}

// Get[[.Entity]] returns a [[.Snake]] by id.
func (s *[[.Entity]]Service) Get[[.Entity]](_ context.Context, req *[[.GoPkg]].Get[[.Entity]]Request) (*[[.GoPkg]].[[.Entity]], error) {
	s.mu.RLock()
	defer s.mu.RUnlock()
	r, ok := s.store[req.GetId()]
	if !ok {
		return nil, apperr.New(apperr.CatNotFound, "[[.Snake]] not found")
	}
	// Clone under the read lock; Update mutates the stored message in place.
	return clone[[.Entity]](r), nil
}

// List[[.Plural]] returns stored [[.PluralSnake]] ordered by id, with paging.
// page_token is the id of the last item on the previous page.
func (s *[[.Entity]]Service) List[[.Plural]](_ context.Context, req *[[.GoPkg]].List[[.Plural]]Request) (*[[.GoPkg]].List[[.Plural]]Response, error) {
	s.mu.RLock()
	all := make([]*[[.GoPkg]].[[.Entity]], len(s.store))
	i := 0
	for _, r := range s.store {
		all[i] = clone[[.Entity]](r)
		i++
	}
	s.mu.RUnlock()
	slices.SortFunc(all, func(a, b *[[.GoPkg]].[[.Entity]]) int { return cmp.Compare(a.GetId(), b.GetId()) })

	start := 0
	if tok := req.GetPageToken(); tok != "" {
		start = len(all)
		for i, r := range all {
			if r.GetId() > tok {
				start = i
				break
			}
		}
	}
	// defaultPageSize bounds a List page when the caller does not set one.
	// Kept function-local so multiple generated services can share package logic
	// without colliding on a package-level identifier.
	const defaultPageSize = 50
	size := int(req.GetPageSize())
	if size <= 0 {
		size = defaultPageSize
	}
	end := min(start+size, len(all))
	page := all[start:end]

	resp := &[[.GoPkg]].List[[.Plural]]Response{[[.Plural]]: page}
	if end < len(all) && len(page) > 0 {
		resp.NextPageToken = page[len(page)-1].GetId()
	}
	return resp, nil
}

// Update[[.Entity]] applies a partial update (PATCH): only fields set in the
// request replace the stored values.
func (s *[[.Entity]]Service) Update[[.Entity]](_ context.Context, req *[[.GoPkg]].Update[[.Entity]]Request) (*[[.GoPkg]].[[.Entity]], error) {
	in := req.Get[[.Entity]]()
	if in == nil || in.GetId() == "" {
		return nil, apperr.New(apperr.CatInvalidArgument, "[[.Snake]].id is required")
	}
	s.mu.Lock()
	defer s.mu.Unlock()
	existing, ok := s.store[in.GetId()]
	if !ok {
		return nil, apperr.New(apperr.CatNotFound, "[[.Snake]] not found")
	}
	if in.GetName() != "" {
		existing.Name = in.GetName()
	}
	return clone[[.Entity]](existing), nil
}

// Delete[[.Entity]] removes a [[.Snake]] by id.
func (s *[[.Entity]]Service) Delete[[.Entity]](_ context.Context, req *[[.GoPkg]].Delete[[.Entity]]Request) (*emptypb.Empty, error) {
	s.mu.Lock()
	defer s.mu.Unlock()
	if _, ok := s.store[req.GetId()]; !ok {
		return nil, apperr.New(apperr.CatNotFound, "[[.Snake]] not found")
	}
	delete(s.store, req.GetId())
	return &emptypb.Empty{}, nil
}
