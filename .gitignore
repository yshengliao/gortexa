# Generated protobuf artifacts — regenerated by `make gen`, never hand-edited.
# Exception: gen/ai/ (the ai.v1 annotation bindings) is committed so that
# `go get` consumers can import the extension types; CI guards it against drift.
/gen/*
!/gen/ai/

# Build output
/bin/
*.out
coverage.*

# Local env / secrets
.env
*.local.yaml

# Editor / OS
.DS_Store
